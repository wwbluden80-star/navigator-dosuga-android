":{"provider":"iNaturalist","licenseAllow":["CC0","CC-BY","CC-BY-SA"],"exactTaxonRequired":true}},{"id":"morel","russianName":"Сморчок настоящий (группа)","scientificName":"Morchella esculenta group","category":"Условно съедобные","guideGroup":"Сморчки и строчки","edibleStatus":"Съедобность требует правильной термообработки; не употреблять сырым","riskLevel":"Требует точной идентификации и приготовления","season":"Весна","forests":["лиственные","смешанные","опушки","нарушенные почвы"],"partnerTrees":["разные, зависит от вида"],"habitat":"Весенние грибы, могут появляться на опушках, гарях и нарушенных участках.","identificationFeatures":["Ячеистая “сотовая” поверхность шляпки","Шляпка у настоящих сморчков обычно соединена с ножкой","Плодовое тело внутри в значительной степени полое"],"dangerousLookalikes":[{"id":"false-morel","label":"Строчок обыкновенный — потенциально токсичный"}],"confusionNotes":"Сморчки и строчки отличаются строением шляпки и внутренней полостью; для новичка весенние аскомицеты требуют осторожности.","warning":"Не использовать сырыми; при сомнении в определении не употреблять.","images":[],"photoQuery":"Morchella esculenta","photoPolicy":{"provider":"iNaturalist","licenseAllow":["CC0","CC-BY","CC-BY-SA"],"exactTaxonRequired":true}},{"id":"false-morel","russianName":"Строчок обыкновенный","scientificName":"Gyromitra esculenta","category":"☠ Опасные / спорные","guideGroup":"Сморчки и строчки","edibleStatus":"Потенциально токсичный; употребление не рекомендуется","riskLevel":"Гиромитрин — серьёзный токсикологический риск","season":"Весна","forests":["сосновые","смешанные","песчаные почвы"],"partnerTrees":["сосна и лесная подстилка"],"habitat":"Весенний гриб, часто на песчаных почвах и нарушенных местах.","identificationFeatures":["Шляпка мозговидно-складчатая, а не регулярная ячеистая","Форма неправильная, лопастная","Внутреннее строение не такое равномерно полое, как у типичных сморчков"],"dangerousLookalikes":[{"id":"morel","label":"Сморчок настоящий — похожий весенний гриб"}],"confusionNotes":"Название “esculenta” не означает безопасность. Токсичность и содержание гиромитрина вариабельны.","toxicityNote":"Гиромитрин и продукты его распада могут вызывать тяжёлое отравление; домашняя обработка не даёт надёжной гарантии безопасности.","images":[],"photoQuery":"Gyromitra esculenta","photoPolicy":{"provider":"iNaturalist","licenseAllow":["CC0","CC-BY","CC-BY-SA"],"exactTaxonRequired":true}},{"id":"woolly-milkcap","russianName":"Волнушка розовая","scientificName":"Lactarius torminosus","category":"Условно съедобные","guideGroup":"Млечники","edibleStatus":"Условно съедобный в традиционной обработке","riskLevel":"Сырой/неправильно обработанный гриб раздражает ЖКТ","season":"Лето — осень","forests":["берёзовые","смешанные с берёзой"],"partnerTrees":["берёза"],"habitat":"Микоризный гриб берёзовых и смешанных лесов.","identificationFeatures":["Розовая зональная шляпка","Сильно опушённый подвёрнутый край у молодых грибов","Белый млечный сок","Пластинки"],"dangerousLookalikes":[],"warning":"Не употреблять сырой; традиционная категория “условно съедобный” не означает, что гриб безопасен без правильной обработки.","images":[],"photoQuery":"Lactarius torminosus","photoPolicy":{"provider":"iNaturalist","licenseAllow":["CC0","CC-BY","CC-BY-SA"],"exactTaxonRequired":true}},{"id":"valui","russianName":"Валуй","scientificName":"Russula foetens","category":"Условно съедобные","guideGroup":"Сыроежки","edibleStatus":"Условно съедобный в традиционной обработке; новичкам не рекомендовать","riskLevel":"Сырой/неправильно обработанный вызывает расстройства","season":"Лето — осень","forests":["лиственные","смешанные","хвойные"],"partnerTrees":["берёза и другие деревья"],"habitat":"Встречается в разных типах леса, иногда массово.","identificationFeatures":["Охристо-коричневая слизистая шляпка","Край зрелой шляпки бороздчатый","Сильный характерный запах","Пластинки могут выделять капли жидкости"],"dangerousLookalikes":[],"warning":"Не ис