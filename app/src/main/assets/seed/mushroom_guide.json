irect/file/Boletus_pinophilus_1.jpg?width=900","author":"см. страницу Wikimedia Commons","license":"CC0 1.0","sourceUrl":"https://commons.wikimedia.org/wiki/File:Boletus_pinophilus_1.jpg","caption":"Белый гриб сосновый"},{"src":"https://commons.wikimedia.org/wiki/Special:Redirect/file/Boletus_pinophilus_01.jpg?width=900","author":"Selmoval","license":"CC BY-SA 4.0","sourceUrl":"https://commons.wikimedia.org/wiki/File:Boletus_pinophilus_01.jpg","caption":"Другой экземпляр"}],"guideGroup":"Болетовые","photoQuery":"Boletus pinophilus","photoPolicy":{"provider":"iNaturalist","licenseAllow":["CC0","CC-BY","CC-BY-SA"],"exactTaxonRequired":true}},{"id":"bay-bolete","russianName":"Польский гриб","scientificName":"Imleria badia","category":"Другие съедобные","edibleStatus":"Съедобный","season":"Лето — осень","forests":["хвойные","смешанные"],"partnerTrees":["сосна","ель и другие хвойные"],"habitat":"Часто связан с хвойными и смешанными лесами, кислой подстилкой и мшистыми участками.","identificationFeatures":["Коричневая шляпка","Трубчатый гименофор","Жёлтоватые поры могут синеть при надавливании","Ножка обычно без выраженной светлой сеточки белого гриба"],"dangerousLookalikes":[],"images":[{"src":"https://commons.wikimedia.org/wiki/Special:Redirect/file/Imleria_badia.jpg?width=900","author":"Tintling","license":"CC BY-SA 4.0","sourceUrl":"https://commons.wikimedia.org/wiki/File:Imleria_badia.jpg","caption":"Польский гриб"}],"guideGroup":"Болетовые","photoQuery":"Imleria badia","photoPolicy":{"provider":"iNaturalist","licenseAllow":["CC0","CC-BY","CC-BY-SA"],"exactTaxonRequired":true}},{"id":"paxillus-involutus","russianName":"Свинушка тонкая","scientificName":"Paxillus involutus","category":"☠ Опасные двойники","edibleStatus":"Ядовитый / не употреблять","season":"Лето — осень","forests":["берёзовые","хвойные","смешанные"],"partnerTrees":["разные древесные породы"],"habitat":"Распространённый лесной гриб; включён в справочник именно как вид, который нельзя считать безопасным